# Copy this file to .env and fill in your values. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Google sign-in. Create an OAuth 2.0 Web client in Google Cloud Console and
# add http://localhost:3000 under "Authorized JavaScript origins". Leave empty
# to hide the Google buttons on the sign-in and register pages.
GOOGLE_CLIENT_ID=

# Polar subscriptions. Create two recurring INR products in the Polar dashboard
# (monthly ₹399 and yearly ₹3,990) and copy their product IDs. The access token
# and webhook secret stay server-side.
POLAR_ACCESS_TOKEN=
POLAR_MONTHLY_PRODUCT_ID=
POLAR_YEARLY_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
# Use the sandbox while testing:
# POLAR_API_BASE_URL=https://sandbox-api.polar.sh/v1
# POLAR_TEST_MODE=true
# Where Polar sends the browser after checkout. The backend appends
# ?checkout=success&checkout_id={CHECKOUT_ID}.
# POLAR_SUCCESS_URL=http://localhost:3000/billing
# Optional: monthly ₹399, yearly ₹3,990 (amounts are in paise).
# POLAR_MONTHLY_AMOUNT=39900
# POLAR_YEARLY_AMOUNT=399000
# MONOTRON_TRIAL_DAYS=3
# BILLING_ENFORCE=true

# Gmail, WhatsApp and Instagram channel connections.
# The Gmail OAuth client needs the Gmail API enabled and this redirect URI:
#   http://localhost:8080/api/channel-connections/GMAIL/oauth/callback
# For WhatsApp/Instagram, create a Meta app and add the matching redirect URIs.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/channel-connections/GMAIL/oauth/callback
# The Google consent screen must grant gmail.readonly (read your email) and
# gmail.send. If a mailbox is connected with only gmail.send, reconnect it.
GMAIL_POLLING_ENABLED=true
GMAIL_POLL_INTERVAL_MS=30000
GMAIL_MAX_PER_POLL=10

META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_WHATSAPP_REDIRECT_URI=http://localhost:8080/api/channel-connections/WHATSAPP/oauth/callback
META_INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/channel-connections/INSTAGRAM/oauth/callback

# Where the OAuth callback sends the browser back to after connecting.
APP_FRONTEND_BASE_URL=http://localhost:3000

# Production: set a dedicated 32+ byte secret for encrypting tenant channel
# tokens and for signing OAuth state. If blank, the JWT secret is used.
CHANNEL_CREDENTIALS_KEY=
CHANNEL_OAUTH_STATE_SECRET=

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# MONOTRON_AI_PROVIDER=auto
