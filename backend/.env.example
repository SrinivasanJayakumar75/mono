# Copy this file to .env and fill in your values. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Google sign-in. Create an OAuth 2.0 Web client in Google Cloud Console and
# add http://localhost:3000 under "Authorized JavaScript origins". Leave empty
# to hide the Google buttons on the sign-in and register pages.
GOOGLE_CLIENT_ID=

# Razorpay subscriptions (test keys start with rzp_test_). Keep the secret
# server-side; the browser only receives RAZORPAY_KEY_ID through the API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: monthly ₹399, yearly ₹3,990 (amounts are in paise).
# RAZORPAY_MONTHLY_AMOUNT=39900
# RAZORPAY_YEARLY_AMOUNT=399000
# MONOTRON_TRIAL_DAYS=3
# BILLING_ENFORCE=true

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# MONOTRON_AI_PROVIDER=auto
